# ========================================
# AIDA Frontend - Environment Configuration Template
# ========================================
# Copy this file to .env and adjust values as needed.
# ========================================

# Backend API URL
# For local development: http://localhost:8000/api
# For production: https://your-domain.com/api
VITE_API_URL=/api

# HTTP MCP endpoint shown in the one-time client setup snippets.
# The default is <window protocol>//<host>:8000/mcp. The isolated dev compose
# sets VITE_MCP_PORT=8001. For TLS/reverse-proxy deployments, set the full URL:
# VITE_MCP_URL=https://your-domain.com/mcp
# VITE_MCP_PORT=8000
# VITE_MCP_URL=
