# ========================================
# APPLICATION METADATA
# ========================================
PROJECT_NAME=AIDA
PROJECT_TAGLINE=AI-Driven Security Audit Platform
PROJECT_DESCRIPTION=Intelligent autonomous penetration testing powered by AI
VERSION=1.1.0
API_V1_PREFIX=/api

# ========================================
# DATABASE CREDENTIALS
# IMPORTANT: Change these values in production!
# ========================================
POSTGRES_USER=aida
POSTGRES_PASSWORD=aida_secure_password_change_me
POSTGRES_DB=aida_assessments
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DATABASE_URL is intentionally omitted here — config.py constructs it
# automatically from the POSTGRES_* variables above.

# ========================================
# CORS ORIGINS
# Comma-separated list. Wildcard "*" is rejected at startup because it is
# incompatible with allow_credentials=True per the CORS spec.
# Dev:    http://localhost:5173,http://127.0.0.1:5173
# Local:  http://localhost:31337,http://127.0.0.1:31337
# LAN:    https://<LAN_IP>,https://localhost,https://127.0.0.1
# Domain: https://your-domain.com
# In prod, start.sh injects the right value automatically.
# ========================================
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========================================
# CONTAINER CONFIGURATION
# Default: aida-pentest (built-in). Set to your Exegol container name if using Exegol.
# ========================================
CONTAINER_WORKSPACE_BASE=/workspace
DEFAULT_CONTAINER_NAME=aida-pentest
COMMAND_TIMEOUT=300

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ========================================
# BACKEND API URL (for MCP server)
# ========================================
BACKEND_API_URL=http://localhost:8000/api

# ========================================
# SECURITY
# ========================================
# JWT signing key. Auto-generated on first start if unset — pin it for
# production so sessions survive redeployments:  openssl rand -hex 32
# SECRET_KEY=your-super-secret-key-min-32-chars-change-me-in-production

# ========================================
# DEVELOPMENT / PRODUCTION
# ========================================
ENVIRONMENT=development
DEBUG=false

# ========================================
# PRODUCTION DEPLOYMENT (docker-compose.prod.yml / k8s)
# See Docs/DEPLOYMENT.md. Both below are set by the deploy manifests;
# listed here for reference. DOCKER_HOST targets the filtered socket proxy
# (compose) or the DinD sidecar (k8s); DEFAULT_CONTAINER_NAME must equal the
# pentest container's name — they are a pair.
# ========================================
# DOCKER_HOST=tcp://docker-proxy:2375
# DEFAULT_CONTAINER_NAME=aida-pentest

# Optional NVD API key deployment secret. Prefer PUT /api/nvd/key for the
# platform-encrypted store; never commit a real key.
# NVD_API_KEY=

# Direct-host MCP execution: disabled and undiscoverable unless explicitly
# enabled with BOTH allowlists. Review Docs/RELIABILITY_OPERATIONS.md first.
AIDA_HOST_EXECUTION_ENABLED=false
# AIDA_HOST_EXECUTION_ALLOWED_WORKING_DIRECTORIES=/srv/aida-work
# AIDA_HOST_EXECUTION_ALLOWED_EXECUTABLES=echo,nmap
# AIDA_HOST_EXECUTION_NETWORK_ACTIONS=nmap
# AIDA_HOST_EXECUTION_ALLOWED_NETWORKS=192.0.2.0/24
# AIDA_HOST_EXECUTION_ALLOWED_DNS_NAMES=target.example
AIDA_HOST_EXECUTION_TIMEOUT_SECONDS=30
AIDA_HOST_EXECUTION_MAX_OUTPUT_BYTES=65536
AIDA_HOST_EXECUTION_MAX_CONCURRENT_EXECUTIONS=4
AIDA_HOST_EXECUTION_MAX_OPERATION_HISTORY=100
